---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';
import { getLocaleCollectionUrl } from '../i18n/utils';

interface Props {
  events: CollectionEntry<'events'>[];
  title?: string;
  fallback?: string;
  intro?: string;
  size?: 'medium' | 'small' | 'meetup';
}

const { events, title, fallback, intro, size } = Astro.props;
const getEventLink = (id: string) =>
  getLocaleCollectionUrl(Astro.currentLocale, 'events', id);
---

<style lang="scss">
  @use '../styles/mq';

  .events {
    margin: 2rem 0;

    @include mq.tablet {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    @include mq.desktop {
      gap: 5rem;
    }
  }

  .event {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    gap: 1rem;
    display: flex;
    flex-direction: column;

    &-date {
      color: var(--color-text-accent);
    }

    &-title {
      font-weight: 400;
      line-height: 1.1;
      font-size: var(--typography-fontsize-m);

      @include mq.tablet {
        font-size: var(--typography-fontsize-l);
      }

      @include mq.desktop {
        /*font-size: var(--typography-fontsize-xl);*/
      }

      a {
        color: var(--color-text-base);
        text-decoration: none;
      }
    }

    &-cover {
      aspect-ratio: 16/9;
      overflow: hidden;

      & > a {
        width: 100%;
        height: 100%;
      }

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>

<section class:list={['meetups']}>
  <SectionTitle>Meetups</SectionTitle>

  <div class="events with-spacing">
    {
      events?.map((event) => (
        <div class="event">
          {event.data.cover && (
            <p class="event-cover">
              <a href={getEventLink(event.id)}>
                <Image
                  src={event.data.cover}
                  format="avif"
                  alt=""
                  height="350"
                />
              </a>
            </p>
          )}

          <h4 class="event-title">
            <a href={getEventLink(event.id)}>{event.data.title}</a>
          </h4>

          <p class="event-date">
            ░&nbsp;{event.data.recurringHumanReadable}&nbsp;░
          </p>
        </div>
      ))
    }
  </div>
</section>
